POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://netgate:change-this-password@db:5432/netgate
REDIS_URL=redis://redis:6379/0
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-this-to-a-long-random-string
# Signs login sessions ('netgate update' fills this in automatically)
APP_SECRET_KEY=change-this-to-another-long-random-string

# Ollama runs on the iMac (uses its GPU); NetGate reaches it over the LAN
OLLAMA_URL=http://192.168.33.17:11434
MODEL=qwen3:8b

# How many search results to crawl per request
MAX_PAGES=5
