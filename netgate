#!/bin/bash
# NetGate server command.  Usage: netgate <command>
#   update             get the latest version from GitHub and restart
#   rollback           go back to the previous version
#   rollback <ver>     go to a specific version, e.g. netgate rollback v0.1
#   versions           list all versions
#   version            show the version running now
#   status | logs | restart | stop | start
set -e
APP_DIR="${NETGATE_DIR:-$HOME/apps/netgate}"
BRANCH=main
cd "$APP_DIR"

ensure_secret() {
  # SearXNG needs a secret key; create one in .env the first time
  grep -q '^SEARXNG_SECRET=' .env 2>/dev/null || echo "SEARXNG_SECRET=$(openssl rand -hex 32)" >> .env
  # NetGate login sessions are signed with this key
  grep -q '^APP_SECRET_KEY=' .env 2>/dev/null || echo "APP_SECRET_KEY=$(openssl rand -hex 32)" >> .env
}

releases() {
  # version list from the latest releases.txt on GitHub (works even after a rollback)
  git show "origin/$BRANCH:releases.txt" 2>/dev/null | grep -E '^v[0-9]' || true
}

commit_of() {
  releases | awk -v v="$1" '$1 == v { print $2 }'
}

current_version() {
  # newest release that the running code contains
  while read -r ver commit _; do
    if git merge-base --is-ancestor "$commit" HEAD 2>/dev/null; then echo "$ver"; return; fi
  done < <(releases)
  git rev-parse --short HEAD
}

deploy() {
  ensure_secret
  docker compose up -d --build --remove-orphans
  docker image prune -f >/dev/null
  echo "NetGate now on version $(current_version) - http://localhost:8090"
}

case "$1" in
  update)
    git fetch -q origin
    git checkout -q "$BRANCH"
    git reset -q --hard "origin/$BRANCH"
    deploy ;;
  rollback)
    git fetch -q origin
    if [ -n "$2" ]; then
      target="$2"
    else
      # the release before the one running now
      now=$(current_version)
      target=$(releases | awk '{ print $1 }' | grep -A1 -x "$now" | sed -n 2p)
      [ -z "$target" ] && { echo "No earlier version to go back to."; exit 1; }
    fi
    commit=$(commit_of "$target")
    [ -z "$commit" ] && { echo "Unknown version: $target  (see: netgate versions)"; exit 1; }
    git checkout -q --detach "$commit"
    echo "Rolled back to $target. Run 'netgate update' to return to the latest version."
    deploy ;;
  versions)
    git fetch -q origin
    echo "Running now: $(current_version)"
    echo ""
    releases | awk '{ v=$1; d=$3; $1=$2=$3=""; sub(/^ +/, ""); printf "%-6s  %s  %s\n", v, d, $0 }' ;;
  version) current_version ;;
  status)  docker compose ps ;;
  logs)    docker compose logs -f --tail=100 web worker ;;
  restart) docker compose restart ;;
  stop)    docker compose down ;;
  start)   docker compose up -d ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
